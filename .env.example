# ==============================================================================
# GTA5VN-SYSTEM BACKEND ENVIRONMENT CONFIGURATION (RUST + VERCEL)
# ==============================================================================
# Cấu hình biến môi trường cho Backend Rust triển khai trên Vercel.
# KHÔNG lưu thông tin bí mật vào file này. Tạo file .env.local cho môi trường cục bộ.

# 1. Môi trường triển khai (development / preview / production)
ENVIRONMENT=production

# 2. Cấp độ log của Rust (error, warn, info, debug, trace)
RUST_LOG=info

# 3. Kết nối Cơ Sở Dữ Liệu Bền Vững (PostgreSQL / Supabase / Neon / Upstash)
# Ví dụ: postgres://user:password@ep-cool-db.us-east-2.aws.neon.tech/gta5vn?sslmode=require
DATABASE_URL=postgres://user:password@host/database?sslmode=require

# 4. Khóa bảo mật API chống truy cập trái phép
API_SECRET_KEY=your_secure_random_secret_key_here
